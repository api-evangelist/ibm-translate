        {
          "id": "e87a5529-402d-4007-9fc0-8a83967960df",
          "name": "Translate",
          "request": {
            "name": "Translate",
            "description": {
              "content": "Translates the input text from the source language to the target language. Specify a model ID that indicates the source and target languages, or specify the source and target languages individually. You can omit the source language to have the service detect it for you. To use a default model, specify only the target language. IBM Watson Language Translator may reject requests if the combined inputs exceed 50 KB.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "translate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>",
                  "description": "(Required) Release date of the API version you want to use. Specify dates in YYYY-MM-DD format. The current version is 2018-05-01."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"model_id\": \"<string>\",\n  \"source\": \"<string>\",\n  \"target\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
